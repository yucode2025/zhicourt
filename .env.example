# ============ ZhiCourt 环境配置示例 ============
# 复制为 .env 后按需填写。真实 .env 不得提交 Git。

# ---------- 应用 ----------
APP_ENV=dev                    # dev | prod
APP_HOST=127.0.0.1
APP_PORT=8000
# deploy/install.sh 的外置生产 env 会固定写入以下三项：
# PUBLIC_ORIGIN=https://court.example.com
# ALLOW_INSECURE_HTTP=false
# 生产必须填写前端的精确 HTTPS Origin（禁止 *、路径和 http）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产必须含 PUBLIC_ORIGIN 的精确主机名；localhost/127.0.0.1/::1 仅由应用保留给本机健康检查
TRUSTED_HOSTS=
# 同时审理的最大案件数（4C4G 建议 3~5）
MAX_CONCURRENT_CASES=3

# ---------- 数据库（MariaDB / MySQL）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhicourt
DB_PASSWORD=
DB_NAME=zhicourt
# 可选：整体覆盖连接串（测试常用 SQLite，如 sqlite:///path/to/test.db）
DATABASE_URL=

# ---------- 管理员（可选）----------
# 设置后 create_admin.py / 启动初始化会幂等创建首个管理员
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- Secret 加密 ----------
# Provider Secret 在数据库为 enc:v1: Fernet 密文。生产必须在外置 /etc/zhicourt/zhicourt.env
# 固定设置并与 DB 备份一起离机保全 44 字符 URL-safe base64 主密钥；不要随发布重新生成。
# 仅开发留空时会使用 backend/.secret_key（切勿提交或丢失）。
SECRET_ENCRYPTION_KEY=
# 仅由部署渲染器使用；先 report-only 验证，确认资源加载后可改 enforce
NGINX_CSP_MODE=report-only

# ---------- Provider 地址防护 ----------
# 所有 Provider 出站默认拒绝内网/保留地址且不跟随重定向。
# 仅 APP_ENV=dev 时可为本地 LLM（如 Ollama）显式置 true；prod 即使置 true 也会 fail closed。
PROVIDER_ALLOW_PRIVATE_URLS=false

# ---------- Redis（可选，不可用时自动降级为内存缓存）----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- LLM（OpenAI 兼容接口）----------
# 未配置时系统进入启发式演示模式（界面明确标注，不伪装真实分析）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90

# ---------- 知乎官方 API（黑客松官方提供）----------
# 推荐：直接在管理后台 /admin/providers 填 Access Secret（保存即生效，无需重启）。
# 此处配置等效于兜底默认。Base URL 留空 = 官方默认 https://developer.zhihu.com
ZHIHU_API_BASE_URL=
ZHIHU_ACCESS_SECRET=
# 旧部署兼容：若未配置 ZHIHU_ACCESS_SECRET，仍会读取 ZHIHU_API_KEY。
# ZHIHU_API_KEY=
# 各能力路径（留空 = 官方默认；直答为 /v1/chat/completions，Knowledge 为
# /api/v1/knowledge/search；Knowledge 需真实 KnowledgeBaseIDs，不是公开 hackathon knowledge/list）
ZHIHU_SEARCH_PATH=
ZHIHU_HOT_PATH=
ZHIHU_DIRECT_ANSWER_PATH=
ZHIHU_KNOWLEDGE_PATH=

# ---------- 全网搜索（官方 global_search，通常与知乎共用同一 Access Secret）----------
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_PATH=

# ---------- 知乎 OAuth 登录/绑定（黑客松赛事页面领取 App ID / App Key）----------
# 三项都配置且校验通过后，前端显示知乎登录/绑定入口；无需 ZHIHU_ACCESS_SECRET。
# App Key 只保存在服务端，不进入前端、授权 URL 或日志；授权 access token 只用于本次读取基础资料，
# 用后丢弃且不持久化。回调地址必须与赛事页面登记值逐字符一致，并使用固定无尾斜杠路径：
# https://your-domain/login/zhihu。该 HTTPS Origin 必须同时包含在 CORS_ORIGINS 中。
# usage_access_policy 是管理后台/数据库运行设置（guest | authenticated | zhihu），不是环境变量；
# 切到 zhihu 前必须先用真实账号验证 OAuth login、本站账号 link 和管理员豁免，避免锁死。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# ---------- 输入限制 ----------
MAX_QUESTION_LENGTH=500
MAX_CHALLENGE_LENGTH=1000
